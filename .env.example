# Copy to .env and replace CHANGE_ME with a random secret (at least 32 characters).
FLAME_SECRET_KEY=CHANGE_ME
FLAME_SERVE_FRONTEND=true
# Optional notification endpoint. Never commit the real value.
FLAME_BARK_URL=
# 窗口过期策略：skip=错过发送时刻就不再深夜补发（转 skipped 并推送通知，默认）；
# dispatch=到点即发（错过也会补发，可能在非预期时刻发出消息）。
FLAME_WINDOW_EXPIRY_POLICY=skip
# 固定发送时刻的宽限期（分钟）：固定时刻即窗口终点，没有宽限期会在到点那一刻被判「已过期」
# 而永远发不出去；宽限期内仍按到点发送，超过才跳过。0=不宽限。仅 skip 策略下生效。
FLAME_FIXED_TIME_GRACE_MINUTES=30
# 登录判定容忍次数：连续 N 次判定失败才把账号标记为登录失效（默认 2）。
# 单次判定抖动（页面加载慢、网络波动）不该锁死账号——调度器会跳过非 healthy 账号。
FLAME_AUTH_CHECK_TOLERANCE=2
# 登录判定预算（秒）：页面打开后等会话列表出现的时长（默认 20）。判定成功立即返回，
# 放宽只影响「确实没登录」时的确认耗时；慢网络下可调大。
FLAME_LOGIN_CHECK_TIMEOUT=20
