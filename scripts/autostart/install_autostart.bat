@echo off
REM ============================================================
REM Flame Contractor autostart installer (Windows, no admin needed)
REM Writes a generated launcher into the current user's Startup
REM folder. Uninstall: delete that file.
REM NOTE: keep this file ASCII-only (cmd parses it as ANSI/GBK).
REM ============================================================
setlocal enabledelayedexpansion
set REPO_DIR=%~dp0..\..
for %%I in ("%REPO_DIR%") do set REPO_DIR=%%~fI
set STARTUP_DIR=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup
set TARGET=%STARTUP_DIR%\flame-contractor-autostart.bat

> "%TARGET%" (
    echo @echo off
    echo REM Generated by Flame Contractor install_autostart.bat. Delete to uninstall.
    echo cd /d "%REPO_DIR%\backend"
    echo start "flame-backend" /min ".venv\Scripts\python.exe" -m uvicorn app.main:app --host 127.0.0.1 --port 8000
    echo cd /d "%REPO_DIR%\frontend"
    echo start "flame-frontend" /min cmd /c "npm run dev"
)

if exist "%TARGET%" (
    echo Installed: %TARGET%
    echo On next Windows logon, backend :8000 and frontend :5173 start minimized.
) else (
    echo Install FAILED. Check path: %TARGET%
    exit /b 1
)
endlocal
