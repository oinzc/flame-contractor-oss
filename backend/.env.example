# Keep the API on the local machine.
# FLAME_DATABASE_URL=sqlite:///D:/Workspace/Flame Contractor/data/flame-contractor.db
# FLAME_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Bark 推送通知（可选）：复制以下到同目录的 .env 文件并填入你自己的 Bark 设备地址。
# 它是本机私密信息，只存于 .env（已被 .gitignore 忽略），不入库、不上传。
# 未配置时自动发送照常运行，只是不推送异常通知。
# FLAME_BARK_URL=https://api.day.app/<你的device_key>
